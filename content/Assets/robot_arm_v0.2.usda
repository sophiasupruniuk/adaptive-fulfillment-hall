                double3 target = (-1.8422349025081246, -2.111750443579651, 1.3552866673693897)
            }
            dictionary Right = {
                double3 position = (0, -500.0000111758711, 0)
                double radius = 500
            }
            dictionary Top = {
                double3 position = (0, 0, 500.0000111758711)
                double radius = 500
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./robot_arm_v0.2.usda"
